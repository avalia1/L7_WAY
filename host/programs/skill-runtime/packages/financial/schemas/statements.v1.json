{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "L7 Financial Statements v1",
  "type": "object",
  "required": ["income_statement", "balance_sheet"],
  "properties": {
    "company": { "type": "string" },
    "period": { "type": "string" },
    "currency": { "type": "string", "default": "USD" },
    "income_statement": {
      "type": "object",
      "required": ["revenue", "net_income"],
      "properties": {
        "revenue": { "type": "number" },
        "cost_of_goods_sold": { "type": "number" },
        "operating_income": { "type": "number" },
        "ebit": { "type": "number" },
        "ebitda": { "type": "number" },
        "interest_expense": { "type": "number" },
        "net_income": { "type": "number" }
      },
      "additionalProperties": true
    },
    "balance_sheet": {
      "type": "object",
      "required": ["total_assets", "shareholders_equity"],
      "properties": {
        "total_assets": { "type": "number" },
        "current_assets": { "type": "number" },
        "cash_and_equivalents": { "type": "number" },
        "accounts_receivable": { "type": "number" },
        "inventory": { "type": "number" },
        "current_liabilities": { "type": "number" },
        "total_debt": { "type": "number" },
        "current_portion_long_term_debt": { "type": "number" },
        "shareholders_equity": { "type": "number" }
      },
      "additionalProperties": true
    },
    "cash_flow": {
      "type": "object",
      "properties": {
        "operating_cash_flow": { "type": "number" },
        "free_cash_flow": { "type": "number" },
        "capex": { "type": "number" }
      },
      "additionalProperties": true
    },
    "market_data": {
      "type": "object",
      "properties": {
        "share_price": { "type": "number" },
        "shares_outstanding": { "type": "number" },
        "earnings_growth_rate": { "type": "number" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
